# ============================================================
# Compta MA - variables d'environnement (copier en .env)
# ============================================================

# --- Environnement d'execution ---
# development | test | staging | production
# En production UNIQUEMENT, l'application refuse de demarrer si :
#   - DEBUG n'est pas false ;
#   - DATABASE_URL cible SQLite ;
#   - SECRET_KEY est encore la valeur d'exemple ou fait moins de 32 caracteres.
# En development/test, ces controles ne s'appliquent pas (valeurs par defaut OK).
ENVIRONMENT=development

# --- Phase 1 : mono-utilisateur, mono-poste (SQLite) ---
DATABASE_URL=sqlite:///./compta_ma.db

# --- Phase 2/3 : multi-utilisateurs sur serveur distant (PostgreSQL) ---
# DATABASE_URL=postgresql+psycopg://compta:motdepasse@localhost:5432/compta_ma

# --- Migrations (Alembic) : OPTIONNEL, reserve a l'execution des migrations ---
# Si definie, Alembic l'utilise ; sinon il retombe sur DATABASE_URL.
# En production elle cible un role DEDIE aux migrations (ex. compta_ma_migrator),
# afin que l'application runtime ne dispose jamais des droits de migration.
# L'application n'a JAMAIS besoin de cette variable pour demarrer.
# MIGRATION_DATABASE_URL=postgresql+psycopg://compta_ma_migrator:MOT_DE_PASSE_A_GENERER@localhost:5432/compta_ma

APP_NAME=Compta MA
DEBUG=true

# SECRET_KEY : obligatoire en production, 32 caracteres minimum (HS256), et
# differente de la valeur d'exemple ci-dessous (interdite en production)
# Generer : python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=__REQUIRED_SECRET_KEY__
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Devise et taux TVA par defaut (bareme TVA 2026 : 20 % et 10 % uniquement)
CURRENCY=MAD
DEFAULT_VAT_RATE=20.00

# Compte de tiers par defaut utilise pour les factures si non renseigne
DEFAULT_CUSTOMER_ACCOUNT=3421
DEFAULT_SUPPLIER_ACCOUNT=4411
VAT_COLLECTED_ACCOUNT=4455
VAT_DEDUCTIBLE_ACCOUNT=3455
BANK_ACCOUNT=5141
CASH_ACCOUNT=5161

# ============================================================
# EXEMPLE DE PRODUCTION (a recopier dans le .env DU SERVEUR uniquement).
# Ce bloc est volontairement commente : il n'est PAS actif par defaut.
# Aucun mot de passe ni secret reel ne doit figurer dans ce depot.
# ============================================================
# ENVIRONMENT=production
# DEBUG=false
# DATABASE_URL=postgresql+psycopg://compta_ma_app:MOT_DE_PASSE_A_GENERER@db:5432/compta_ma
# MIGRATION_DATABASE_URL=postgresql+psycopg://compta_ma_migrator:MOT_DE_PASSE_A_GENERER@db:5432/compta_ma
# SECRET_KEY=A_GENERER_EXTERIEUREMENT_ET_NE_PAS_COMMITTER

# ============================================================
# DOCKER / PRODUCTION (PG6E2) - a recopier dans le .env DU SERVEUR
# ------------------------------------------------------------
# IMPORTANT:
# COMPTA_MA_APP_PASSWORD et COMPTA_MA_MIGRATOR_PASSWORD sont injectes
# directement dans des URL PostgreSQL. Utiliser des mots de passe URL-safe.
# Exemple de generation :
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Reference de deploiement : `docker-compose.yml`
#   db (PostgreSQL 18) -> migrate (one-shot : alembic upgrade head) -> app
#
# Roles PostgreSQL crees au premier demarrage par
# `docker/postgres/10-init-compta-roles.sh` :
#   compta_ma_owner    (NOLOGIN) proprietaire de la base et du schema public
#   compta_ma_migrator (LOGIN)   migrations Alembic uniquement
#   compta_ma_app      (LOGIN)   application : CONNECT + USAGE sur public,
#                                aucun droit CREATE, aucun droit de migration
#
# Variables OBLIGATOIRES en Docker : aucun repli n'est fourni, `docker compose
# up` echoue immediatement si l'une d'elles manque (syntaxe ${VAR:?message}).
# Remplacer UNIQUEMENT les placeholders, et ne jamais commiter les valeurs :
# POSTGRES_PASSWORD=MOT_DE_PASSE_A_GENERER
# COMPTA_MA_APP_PASSWORD=MOT_DE_PASSE_A_GENERER
# COMPTA_MA_MIGRATOR_PASSWORD=MOT_DE_PASSE_A_GENERER
# SECRET_KEY=A_GENERER_EXTERIEUREMENT_ET_NE_PAS_COMMITTER
#
# Separation DATABASE_URL / MIGRATION_DATABASE_URL (PG6E1, conservee en Docker) :
#   DATABASE_URL            cible le role APPLICATIF    compta_ma_app
#   MIGRATION_DATABASE_URL  cible le role de MIGRATION  compta_ma_migrator
# Le service `app` ne recoit QUE DATABASE_URL (le role applicatif n'a jamais les
# droits de migration) ; le service `migrate` recoit MIGRATION_DATABASE_URL.
# Pour Docker, docker-compose.yml construit les deux URL a partir des variables
# ci-dessus ; les deux variables restent la reference pour un deploiement hors
# Docker (venv + systemd) :
#   DATABASE_URL=postgresql+psycopg://compta_ma_app:MOT_DE_PASSE_A_GENERER@db:5432/compta_ma
#   MIGRATION_DATABASE_URL=postgresql+psycopg://compta_ma_migrator:MOT_DE_PASSE_A_GENERER@db:5432/compta_ma
#
# Generer des secrets compatibles URL (alphabet [-_A-Za-z0-9]) :
#   python -c "import secrets;print(secrets.token_urlsafe(48))"