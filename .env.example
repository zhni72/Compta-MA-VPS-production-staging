# ============================================================
# Compta MA - variables d'environnement (copier en .env)
# ============================================================

# --- Phase 1 : mono-utilisateur, mono-poste (SQLite) ---
DATABASE_URL=sqlite:///./compta_ma.db

# --- Phase 2/3 : multi-utilisateurs sur serveur distant (PostgreSQL) ---
# DATABASE_URL=postgresql+psycopg://compta:motdepasse@localhost:5432/compta_ma

APP_NAME=Compta MA
DEBUG=true

# SECRET_KEY : obligatoire en production, 32 caracteres minimum (HS256)
# Generer : python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=compta-ma-secret-a-remplacer-en-production-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Devise et taux TVA par defaut (bareme TVA 2026 : 20 % et 10 % uniquement)
CURRENCY=MAD
DEFAULT_VAT_RATE=20.00

# Compte de tiers par defaut utilise pour les factures si non renseigne
DEFAULT_CUSTOMER_ACCOUNT=3421
DEFAULT_SUPPLIER_ACCOUNT=4411
VAT_COLLECTED_ACCOUNT=4455
VAT_DEDUCTIBLE_ACCOUNT=3455
BANK_ACCOUNT=5141
CASH_ACCOUNT=5161