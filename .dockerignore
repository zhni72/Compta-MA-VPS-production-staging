# Compta MA - exclusions du contexte de construction Docker.
# Le conteneur embarque uniquement l'application, les migrations et les
# referentiels metier. Les donnees locales, le venv Windows, les caches et
# les secrets n'ont pas a entrer dans l'image.

# --- Python / venv local ---
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Secrets / config locale ---
# `.env` et ses variantes ne doivent JAMAIS entrer dans l'image ; seul
# `.env.example` (documentation, sans valeur reelle) est conserve.
.env
.env.*
!.env.example

# --- Donnees locales (bases, sauvegardes, pieces, exports) ---
*.db
*.sqlite*
*.bak*
media/
exports/
backups/

# --- Fichiers temporaires / artefacts locaux ---
*.tmp
*.log
logs/
.coverage
htmlcov/
coverage.xml

# --- Rapports et jeux de tests locaux (non requis par l'application) ---
recette_j9/
/pg5*.xml

# --- Fichiers de construction / deploiement (hors runtime) ---
Dockerfile
docker-compose*.yml
.dockerignore
.gitattributes

# --- VCS / IDE / documentation hors runtime ---
.git/
.gitignore
.vscode/
.idea/
Thumbs.db
